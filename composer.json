{
    "name": "potato/smart-judge",
    "description": "Asks an AI model yes/no questions about subjects a consumer describes.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Potato\\SmartJudge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Potato\\SmartJudge\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
